{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": {} },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "single" } },
      "title": "Ops/sec by operation",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(shardkv_operations_total[30s])) by (op)",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "custom": {} },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "title": "Latency percentiles (set)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(shardkv_operation_duration_seconds_bucket{op=\"set\"}[30s])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(shardkv_operation_duration_seconds_bucket{op=\"set\"}[30s])) by (le))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.999, sum(rate(shardkv_operation_duration_seconds_bucket{op=\"set\"}[30s])) by (le))",
          "legendFormat": "p999"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Follower" }, "1": { "text": "Candidate" }, "2": { "text": "Leader" }, "3": { "text": "Shutdown" } }, "type": "value" }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "green", "value": 2 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Raft State by Node and Shard",
      "type": "stat",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "shardkv_raft_state", "legendFormat": "{{node}} shard {{shard}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": {} },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Raft Commit vs Applied Index by Shard",
      "type": "timeseries",
      "targets": [
        { "expr": "shardkv_raft_commit_index", "legendFormat": "commit {{node}} shard {{shard}}" },
        { "expr": "shardkv_raft_applied_index", "legendFormat": "applied {{node}} shard {{shard}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": {}, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 8,
      "title": "Replication Lag by Shard",
      "type": "timeseries",
      "targets": [
        { "expr": "shardkv_shard_replication_lag", "legendFormat": "{{node}} shard {{shard}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": {} },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "title": "Error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(shardkv_operations_total{status!=\"ok\",status!=\"not_found\"}[30s])) by (op, status)",
          "legendFormat": "{{op}} {{status}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["shardkv", "distributed-systems"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
